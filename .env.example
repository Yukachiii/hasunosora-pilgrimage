# サーバーからRoutes APIを呼ぶ専用キー。ブラウザ用キーとは分け、Routes APIだけに制限します。
GOOGLE_ROUTES_SERVER_API_KEY=

# ルートAPIの利用を許可するWebサイトのOrigin。複数指定時はカンマ区切り。
ROUTE_API_ALLOWED_ORIGINS=https://yukachiii.github.io

# GitHub Pagesから別途公開したルートAPIを使う場合の完全なURL。
VITE_ROUTE_API_URL=

# ローカル管理画面からサーバー側のAPI使用状況を取得する完全なURL。
# VITE_ROUTE_API_URLが設定済みなら、未設定でも同じサーバーから自動推測します。
ROUTE_USAGE_API_URL=

# API使用状況をローカル管理画面だけへ返す共有トークン。十分に長いランダム値を指定します。
# ルートAPIサーバーとローカルの.env.localへ同じ値を設定し、Gitには追加しません。
ROUTE_USAGE_ADMIN_TOKEN=

# /admin を利用できるSign in with ChatGPTアカウント。複数指定時はカンマ区切り。
ADMIN_EMAIL=

# ローカルホストで管理画面を確認する場合のみ1。公開ドメインでは常に無効です。
ADMIN_LOCAL_DEV=0

# 公開ページのMapbox地図で使う公開トークン。pk.から始まるサイト専用トークンを指定します。
MAPBOX_PUBLIC_ACCESS_TOKEN=

# GitHub Pages版のMapbox地図で使う公開トークン。
VITE_MAPBOX_ACCESS_TOKEN=

# GitHub Pagesから投稿を受け付ける自宅サーバーのHTTPS公開URL（末尾の/api/submissionsは不要）。
VITE_COMMUNITY_API_URL=

# Cloudflare Turnstileの公開用サイトキー。GitHub ActionsへはRepository variableとして設定します。
VITE_TURNSTILE_SITE_KEY=

# Next.js版で同じ投稿UIを使う場合の受付URL・公開サイトキー。
COMMUNITY_API_URL=
TURNSTILE_SITE_KEY=

# 自宅の投稿受付サーバー設定。受付プロセス自体は127.0.0.1だけで待ち受けます。
COMMUNITY_SERVER_PORT=8790
COMMUNITY_ALLOWED_ORIGINS=https://yukachiii.github.io
COMMUNITY_SUBMISSIONS_DIRECTORY=
COMMUNITY_CONSENT_VERSION=2026-09-04
COMMUNITY_RETENTION_DAYS=30

# Turnstileの秘密キーと、IPを日替わりハッシュへ変換する十分に長いランダム値。
# どちらもGitへ追加せず、自宅サーバーの.env.localだけへ設定します。
TURNSTILE_SECRET_KEY=
COMMUNITY_RATE_LIMIT_SECRET=
