# Google Cloud Console で Maps JavaScript API と Routes API を有効化してください。
# 本番キーには、公開するWebサイトのHTTPリファラー制限を必ず設定します。
GOOGLE_MAPS_BROWSER_API_KEY=

# Advanced Markers用のMap ID。未設定時は開発用のDEMO_MAP_IDを利用します。
GOOGLE_MAPS_MAP_ID=

# サーバーからRoutes APIを呼ぶ専用キー。ブラウザ用キーとは分け、Routes APIだけに制限します。
GOOGLE_ROUTES_SERVER_API_KEY=

# ルートAPIの利用を許可するWebサイトのOrigin。複数指定時はカンマ区切り。
ROUTE_API_ALLOWED_ORIGINS=https://yukachiii.github.io

# GitHub Pagesから別途公開したルートAPIを使う場合の完全なURL。
VITE_ROUTE_API_URL=

# /admin を利用できるSign in with ChatGPTアカウント。複数指定時はカンマ区切り。
ADMIN_EMAIL=

# ローカルホストで管理画面を確認する場合のみ1。公開ドメインでは常に無効です。
ADMIN_LOCAL_DEV=0
